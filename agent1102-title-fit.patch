 header {
-  display:grid; grid-template-columns:auto 1fr; grid-template-areas:"title title" "left right";
-  align-items:center; row-gap:0.35rem; column-gap:0.5rem;
+  --title-h:2.15rem; /* the title's band across the top of the bar */
+  display:grid; grid-template-columns:auto 1fr; grid-template-areas:"title title" "left right"; grid-template-rows:var(--title-h) auto;
